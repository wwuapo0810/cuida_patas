# Copiar a .env antes de levantar el stack:  cp .env.example .env
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.

# --- Base de datos ---
MYSQL_DATABASE=cuidapatas
MYSQL_USER=cuidapatas_app
MYSQL_PASSWORD=cambiar_esto_en_local
MYSQL_ROOT_PASSWORD=cambiar_esto_root_en_local

# --- Autenticación (JWT) ---
# Clave con la que se firman los tokens. OBLIGATORIA: sin ella el backend no
# arranca. Mínimo 32 bytes. Generá la tuya y NO reutilices este texto:
#   openssl rand -base64 48
# En Windows sin openssl, desde PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=grEE9SvzUj3wZ9MacwmmHehYzwQ00MvOiTsO+O04s3HWTmmlbcz7SdNdxySahbxv
# Vigencia del token en minutos (480 = 8 horas).
JWT_EXPIRACION_MINUTOS=480

# --- CORS ---
# Orígenes del navegador autorizados a llamar la API, separados por coma.
# Es el servidor de desarrollo de Vite; cambialo si usás otro puerto.
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Puertos expuestos en la máquina anfitriona ---
# Cambiar si ya tenés algo ocupando estos puertos (XAMPP, otro MySQL, etc.)
MYSQL_PORT=3306
BACKEND_PORT=8080

# --- Frontend (Vite) ---
# Vite lee este mismo archivo .env, pero SOLO expone al navegador las variables
# que empiezan con VITE_. Las credenciales de arriba nunca llegan al bundle.
# Si cambiás BACKEND_PORT, actualizá también este puerto.
VITE_API_URL=http://localhost:8080
